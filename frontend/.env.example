# Supabase Auth. The publishable key is safe to expose to browser code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Private URL used by the Next.js server-side API boundary
BACKEND_API_URL=http://localhost:8000/api/v1

# Shared only by the Next.js server and FastAPI. Generate with: openssl rand -hex 32
BACKEND_PROXY_SECRET=

# Must match CONTACT_PROXY_SECRET configured on FastAPI
CONTACT_PROXY_SECRET=

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
