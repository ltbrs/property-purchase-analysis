{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check Docker",
      "type": "process",
      "command": "docker",
      "args": ["info"],
      "problemMatcher": []
    },
    {
      "label": "Start Services",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "-d"],
      "dependsOn": "Check Docker",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Backend",
      "type": "process",
      "command": "uv",
      "args": ["run", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "backend",
        "pattern": {
          "regexp": "(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running on.*",
          "endsPattern": ".*Application startup complete.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Frontend",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "frontend",
        "pattern": {
          "regexp": "(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*next dev.*",
          "endsPattern": ".*Ready in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Full Stack",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Start Services",
        "Start Backend",
        "Start Frontend"
      ],
      "problemMatcher": []
    }
  ]
}
