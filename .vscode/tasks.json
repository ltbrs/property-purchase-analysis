{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check Docker",
      "type": "shell",
      "command": "docker info",
      "problemMatcher": []
    },
    {
      "label": "Start Services",
      "type": "shell",
      "command": "docker compose up -d",
      "dependsOn": "Check Docker",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "${env:HOME}/.local/node-current/bin:${env:HOME}/.local/bin:${env:PATH}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "backend",
        "pattern": {
          "regexp": "(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running on.*",
          "endsPattern": ".*Application startup complete.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "PATH": "${env:HOME}/.local/node-current/bin:${env:HOME}/.local/bin:${env:PATH}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "frontend",
        "pattern": {
          "regexp": "(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*next dev.*",
          "endsPattern": ".*Ready in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Full Stack",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Start Services",
        "Start Backend",
        "Start Frontend"
      ],
      "problemMatcher": []
    }
  ]
}
