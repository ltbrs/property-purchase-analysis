# Application
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_DB=property_analysis
POSTGRES_USER=property_analysis
POSTGRES_PASSWORD=property_analysis
DATABASE_URL=postgresql+psycopg://property_analysis:property_analysis@localhost:5432/property_analysis

# Private S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=property-documents
OBJECT_STORAGE_REGION=eu-west-3
OBJECT_STORAGE_ACCESS_KEY=property_analysis
OBJECT_STORAGE_SECRET_KEY=change-this-local-secret
DOCUMENT_VIEW_URL_TTL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=26214400

# OpenAI structured extraction. The model is fixed in application code.
OPENAI_API_KEY=

# Public ADEME DPE registry lookup (no API key required)
ADEME_DPE_API_URL=https://data.ademe.fr/data-fair/api/v1/datasets/dpe03existant
ADEME_DPE_API_TIMEOUT_SECONDS=5

# Shared only by the Next.js server and FastAPI. Generate with: openssl rand -hex 32
CONTACT_PROXY_SECRET=
CONTACT_SHORT_RATE_LIMIT=5
CONTACT_DAILY_RATE_LIMIT=20
